# Copia este archivo como .env si arrancas la API SIN Docker.
# Con Docker estas variables se definen en docker-compose.yml.

PORT=8000
DATABASE_URL=postgres://sportryn:sportryn@localhost:5433/sportryn
TEST_DATABASE_URL=postgres://sportryn:sportryn@localhost:5433/sportryn_test

# URL pública del frontend y de la API
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Orígenes permitidos (separados por comas). "*" = cualquiera (solo en local).
# En producción: https://app.tudominio.com,https://tudominio.com,https://localhost,capacitor://localhost
CORS_ORIGINS=*

APP_TIMEZONE=Europe/Madrid

# Pagos: "fake" (pago simulado) o "stripe"
PAYMENTS_DRIVER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Fotos
MEDIA_DIR=storage/media
MAX_UPLOAD_MB=8

# Límites por minuto y por IP
RL_LOGIN=10
RL_REGISTER=10
RL_REGISTRATIONS=20
RL_WAITLIST=5
